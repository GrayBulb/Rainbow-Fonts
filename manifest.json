{
  "manifest_version": 3,
  "name": "Rainbow Fonts",
  "version": "1.0",
  "description": "Applies rainbow text to every text in the pag,e gets quite laggy.",
  "permissions": [ "activeTab" ],
  "host_permissions": [ "<all_urls>" ],
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [ "rainbowFonts.js" ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
